# ロガー設定ファイル（サンプル）
# 実際に使用する場合は、このファイルをコピーして logger_config.ini として保存してください。
# logger_config.ini は .gitignore に登録されているため、機密情報を含めても安全です。

[logger]
# ログレベル: DEBUG, INFO, WARNING, ERROR, CRITICAL
level = INFO

# ログフォーマット
# 利用可能な変数: %(asctime)s, %(levelname)s, %(name)s, %(message)s など
format = %(asctime)s [%(levelname)s] %(name)s: %(message)s

# 日時フォーマット
date_format = %Y-%m-%d %H:%M:%S

# ローテーション設定
# rotation_when: ローテーションのタイミング
#   - S: 秒ごと
#   - M: 分ごと
#   - H: 時間ごと
#   - D: 日ごと
#   - midnight: 深夜0時（推奨）
#   - W0-W6: 曜日ごと（0=月曜日）
rotation_when = midnight

# rotation_interval: ローテーション間隔（rotation_when の単位）
rotation_interval = 1

# backup_count: 保持するバックアップファイル数（0=無制限、全日保持）
backup_count = 0

# 注意事項:
# - このファイルにはパスワードや機密情報を含めないでください
# - ログファイルのパスは setup_logger() の引数で指定します
# - 本番環境では適切なログレベルとローテーション設定を行ってください
